<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- cinema.person list view -->
    <record id="cinema_person_view_list" model="ir.ui.view">
        <field name="name">cinema.person.view.list</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <list string="People" decoration-danger="date_of_death==True"> <!--vermell si és mort-->
                <field name="full_name" />
                <field name='gender' />
                <field name="country_id" />
                <field name="birthdate" />
                <field name='date_of_death' />
                <field name="is_director" />
                <field name="is_actor" />
            </list>
        </field>
    </record>

    <record id="cinema_person_view_form" model="ir.ui.view">
        <field name="name">cinema.person.view.form</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <form string="Cinema Person">
                <sheet>

                    <group col="8">

                        <field name="last_name" colspan="4" />
                        <field name="birthdate" colspan="2" />
                        <field name="gender" colspan="2" />

                        <field name="first_name" colspan="4" />
                        <field name="date_of_death" colspan="2" />
                        <field name="country_id" colspan="2" />

                        <field name="is_director" colspan="2" />
                        <field name="is_actor" colspan="2" />
                        <div colspan="4" />

                    </group>

                    <group col="8">

                        <field name="directed_films_ids" colspan="4" string="Directed Films">
                            <list>
                                <field name="title" />
                                <field name="duration" />
                                <field name="web_page" />
                            </list>
                        </field>

                        <field name="acted_films_ids" colspan="4" string="Acted Films">
                            <list>
                                <field name="title" />
                                <field name="duration" />
                                <field name="web_page" />
                            </list>
                        </field>

                    </group>

                </sheet>
            </form>
        </field>
    </record>


</odoo>