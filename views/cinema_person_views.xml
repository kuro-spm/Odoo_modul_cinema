<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- cinema.person list view -->
    <record id="cinema_person_view_list" model="ir.ui.view">
        <field name="name">cinema.person.view.list</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <list string="People" decoration-danger="date_of_death==True"> <!--vermell si és mort-->
                <field name="full_name" />
                <field name='gender' />
                <field name="country_id" />
                <field name="birthdate" />
                <field name='date_of_death' />
                <field name="is_director" />
                <field name="is_actor" />
            </list>
        </field>
    </record>

    <!-- cinema.person form view -->
    <record id="cinema_person_view_form" model="ir.ui.view">
        <field name="name">cinema.person.view.form</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>

                    <group col="4">

                        <group name="personal_names">
                            <field name="last_name" />
                            <field name="first_name" />
                        </group>

                        <group col="4">
                            <group name="biography_dates">
                                <field name="birthdate" />
                                <field name="date_of_death" />
                            </group>

                            <group name="demographics_and_roles">
                                <field name="gender" />
                                <field name="country_id" />
                            </group>
                        </group>

                        <group col="4">
                            <field name="is_director" />
                            <field name="is_actor" />
                        </group>

                    </group>

                    <group col="2">

                        <group string="Directed Films">
                            <field name="directed_films_ids" nolabel="1">
                                <list>
                                    <field name="title" />
                                    <field name="duration" />
                                    <field name="web_page" />
                                </list>
                            </field>
                        </group>

                        <group string="Acted Films">
                            <field name="acted_films_ids" nolabel="1">
                                <list>
                                    <field name="title" />
                                    <field name="duration" />
                                    <field name="web_page" />
                                </list>
                            </field>
                        </group>

                    </group>

                </sheet>
            </form>
        </field>
    </record>


</odoo>