<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- cinema.person list view -->
    <record id="cinema_person_view_list" model="ir.ui.view">
        <field name="name">cinema.person.view.list</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <!-- persones vives en verd, persones mortes en vermell -->
            <list string="People"
                  decoration-success="not date_of_death"
                  decoration-danger="date_of_death">
                <field name="full_name" />
                <field name="gender" />
                <field name="country_id" />
                <field name="birthdate" />
                <field name="date_of_death" />
                <field name="is_director" />
                <field name="is_actor" />
            </list>
        </field>
    </record>

    <!-- cinema.person form view -->
    <record id="cinema_person_view_form" model="ir.ui.view">
        <field name="name">cinema.person.view.form</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <form string="Cinema Person">
                <sheet>
                    <group>
                        <group string="Informació personal">
                            <field name="last_name" />
                            <field name="first_name" />
                            <field name="gender" />
                            <field name="country_id" />
                        </group>

                        <group string="Dates i rols professionals">
                            <field name="birthdate" />
                            <field name="date_of_death" />
                            <field name="is_director" />
                            <field name="is_actor" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Films dirigits" name="directed_films"
                              invisible="not is_director">
                            <field name="directed_films_ids" readonly="1">
                                <list>
                                    <field name="title" />
                                    <field name="duration" />
                                    <field name="web_page" />
                                </list>
                            </field>
                        </page>

                        <page string="Films com a actor/actriu" name="acted_films"
                              invisible="not is_actor">
                            <field name="acted_films_ids" readonly="1">
                                <list>
                                    <field name="title" />
                                    <field name="duration" />
                                    <field name="web_page" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
