<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- cinema.person list view -->
    <record id="cinema_person_view_list" model="ir.ui.view">
        <field name="name">cinema.person.view.list</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <list string="People" decoration-danger="date_of_death==True"> <!--vermell si és mort-->
                <field name="full_name" />
                <field name='gender' />
                <field name="country_id" />
                <field name="birthdate" />
                <field name='date_of_death' />
                <field name="is_director" />
                <field name="is_actor" />
            </list>
        </field>
    </record>

    <!-- cinema.person form view -->
    <record id="cinema_person_view_form" model="ir.ui.view">
        <field name="name">cinema.person.view.form</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group col='4'>
                            <field name="last_name" colspan='4' />
                            <field name="first_name" colspan='4' />
                            <field name="birthdate" />
                            <field name="date_of_death" />
                        </group>
                        <group col='4'>
                            <field name="gender" />
                            <field name="country_id" />
                            <field name="is_director" />
                            <field name="is_actor" />
                        </group>
                        <group col='8'>
                            <field name="directed_films_ids">


                            </field>

                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>


</odoo>